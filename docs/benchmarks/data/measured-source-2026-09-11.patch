+def _required_gradle_string(text: str, field: str, path: Path) -> str:
+    match = re.search(rf"^\s*{re.escape(field)}\s*=\s*'([^']+)'\s*$", text, re.MULTILINE)
+    if match is None:
+        raise ValueError(f"Missing {field} in {path}")
+    return match.group(1)
+
