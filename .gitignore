**/.project

# PMD plugin conf
.pmd

# jqwik local db
.jqwik-database

##---------------------------------------------------------------------------------------- Gradle
.gradle/
**/build/

# MkDocs generated site
/site/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring the Gradle Wrapper JAR
!gradle-wrapper.jar

# Gradle task-name cache
.gradletasknamecache

